<Page x:Class="SoZvon.UI.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SoZvon" mc:Ignorable="d"
      Title="RegisterPage">

    <Grid Width="434" Height="459">

        <Rectangle Fill="#FFFFBC4E" Opacity="0.955" StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="0,-1,0,-1" RadiusX="20" RadiusY="20"/>

        <Grid Margin="0,30,0,0" Height="56" VerticalAlignment="Top" Width="194">
            <Rectangle Fill="White" StrokeThickness="1.5" Stroke="#FF5D5D5D" RadiusX="20" RadiusY="20"/>
            <TextBlock Text="Регистрация" Language="ru-ru" FontSize="25" FontFamily="Comic Sans MS" TextAlignment="Center" Margin="10,10,10,10"/>
        </Grid>

        <Grid Name="Email_Text" HorizontalAlignment="Center" Width="310" Height="49" VerticalAlignment="Bottom" Margin="0,0,0,283">
            <Rectangle Fill="#FFFFFAE0" StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="0,0,-1,0" RadiusX="20" RadiusY="20"/>
            <TextBox Name="TextBox_Email_Hint" TextWrapping="Wrap" Language="ru-ru" Background="Transparent" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Left" Text="Почта" Margin="21,10,21,10" BorderThickness="0" IsEnabled="False"/>
            <TextBox Cursor="IBeam" Name="TextBox_Email" TextWrapping="Wrap" Language="ru-ru" Background="Transparent" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Left" Margin="21,10,21,10" BorderThickness="0" TextChanged="ChangedText_Page" MaxLength="30"/>
        </Grid>

        <Grid Name="Name_Text" HorizontalAlignment="Center" Width="310" Height="49" VerticalAlignment="Bottom" Margin="0,0,0,229">
            <Rectangle Fill="#FFFFFAE0" StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="0,0,-1,0" RadiusX="20" RadiusY="20"/>
            <TextBox Name="TextBox_Name_Hint" TextWrapping="Wrap" Language="ru-ru" Background="Transparent" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Left" Text="Имя" Margin="21,10,21,10" BorderThickness="0" IsEnabled="False"/>
            <TextBox Cursor="IBeam" Name="TextBox_Name" TextWrapping="Wrap" Language="ru-ru" Background="Transparent" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Left" Margin="21,10,21,10" BorderThickness="0" TextChanged="ChangedText_Page" MaxLength="16"/>
        </Grid>

        <Grid Name="Login_Text" HorizontalAlignment="Center" Width="310" Margin="0,0,0,175" Height="49" VerticalAlignment="Bottom">
            <Rectangle Fill="#FFFFFAE0" StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="0,0,-1,0" RadiusX="20" RadiusY="20"/>
            <TextBox Name="TextBox_Login_Hint" TextWrapping="Wrap" Language="ru-ru" Background="Transparent" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Left" Text="Логин" Margin="21,10,21,10" BorderThickness="0" IsEnabled="False"/>
            <TextBox Cursor="IBeam" Name="TextBox_Login" TextWrapping="Wrap" Language="ru-ru" Background="Transparent" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Left" Margin="21,10,21,10" BorderThickness="0" TextChanged="ChangedText_Page" MaxLength="16"/>
        </Grid>

        <Grid Name="Password_Text" HorizontalAlignment="Center" Width="310" Height="49" VerticalAlignment="Bottom" Margin="0,0,0,121">
            <Rectangle Fill="#FFFFFAE0" StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="0,0,-1,0" RadiusX="20" RadiusY="20"/>
            <TextBox Name="TextBox_Password_Hint" TextWrapping="Wrap" Language="ru-ru" Background="Transparent" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Left" Text="Пароль" Margin="21,10,21,10" BorderThickness="0" IsEnabled="False"/>
            <TextBox Cursor="IBeam" Name="TextBox_Password" TextWrapping="Wrap" Language="ru-ru" Background="Transparent" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Left" Margin="21,10,21,10" BorderThickness="0" TextChanged="ChangedText_Page" MaxLength="16"/>
        </Grid>

        <Grid Name="Register_Button_RegPage" Cursor="Hand" Margin="0,375,0,0" HorizontalAlignment="Center" Width="224" Height="49" VerticalAlignment="Top">
            <Rectangle Tag="Background" Fill="#FFFDE886" StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="0,0,-1,0" RadiusX="20" RadiusY="20"/>
            <TextBlock Tag="Text" TextWrapping="Wrap" Language="ru-ru" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Center" Margin="10,10,10,10" Text="Зарегистрироваться"/>
        </Grid>

        <Grid Name="Exit_Button_RegPage" Cursor="Hand" Margin="10,10,0,0" HorizontalAlignment="Left" Width="50" Height="48" VerticalAlignment="Top">
            <Rectangle Tag="Background" Fill="#FFFFE49B" StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="0,0,5,5" RadiusX="20" RadiusY="20"/>
            <TextBlock Tag="Text" Foreground="Black" FontSize="25" FontFamily="Comic Sans MS" TextAlignment="Center" Text="X" Margin="12,4,18,15"/>
        </Grid>

    </Grid>

</Page>
