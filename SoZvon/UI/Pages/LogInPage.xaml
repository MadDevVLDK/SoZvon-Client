<Page x:Class="SoZvon.UI.Pages.LogInPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SoZvon"
      mc:Ignorable="d" Title="LogInPage">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid HorizontalAlignment="Center" Width="434" Height="398" VerticalAlignment="Top">

            <Rectangle Fill="#FFFFBC4E" Opacity="0.955" StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="0,-1,0,-1" RadiusX="20" RadiusY="20"/>

            <Rectangle Fill="White" StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="152,30,148,320" RadiusX="20" RadiusY="20"/>
            <TextBlock FontSize="25" FontFamily="Comic Sans MS" TextAlignment="Center" Margin="172,34,172,0" Text="Вход" VerticalAlignment="Top" Height="44"/>

            <Grid Name="Login_Text" HorizontalAlignment="Center" Width="310" Height="49" VerticalAlignment="Bottom" Margin="0,0,0,244">
                <Rectangle Fill="#FFFFFAE0" StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="0,0,-1,0" RadiusX="20" RadiusY="20"/>
                <TextBox Name="TextBox_Login_Hint" TextWrapping="Wrap" Language="ru-ru" Background="Transparent" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Left" Text="Логин" Margin="21,10,21,10" BorderThickness="0" IsEnabled="False"/>
                <TextBox Cursor="IBeam" Name="TextBox_Login" TextWrapping="Wrap" Language="ru-ru" Background="Transparent" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Left" Margin="21,10,21,10" BorderThickness="0" TextChanged="ChangedText_Page" MaxLength="16"/>
            </Grid>

            <Grid Name="Password_Text" HorizontalAlignment="Center" Width="310" Height="49" VerticalAlignment="Bottom" Margin="0,0,0,185">
                <Rectangle Fill="#FFFFFAE0" StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="0,0,-1,0" RadiusX="20" RadiusY="20"/>
                <TextBox Name="TextBox_Password_Hint" TextWrapping="Wrap" Language="ru-ru" Background="Transparent" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Left" Text="Пароль" Margin="21,10,21,10" BorderThickness="0" IsEnabled="False"/>
                <TextBox Cursor="IBeam" Name="TextBox_Password" TextWrapping="Wrap" Language="ru-ru" Background="Transparent" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Left" Margin="21,10,21,10" BorderThickness="0" TextChanged="ChangedText_Page" MaxLength="16"/>
            </Grid>

            <Grid Name="Login_Button" Cursor="Hand" Margin="0,0,0,73" HorizontalAlignment="Center" Width="224" Height="49" VerticalAlignment="Bottom">
                <Rectangle Tag="Background" Fill="#FFFFDD3A" StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="0,0,-1,0" RadiusX="20" RadiusY="20"/>
                <TextBlock Tag="Text" TextWrapping="Wrap" Language="ru-ru" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Center" Margin="10,10,10,10" Text="Войти"/>
            </Grid>

            <Grid Name="Register_Button_LogPage" Cursor="Hand" Margin="0,0,0,18" HorizontalAlignment="Center" Width="178" Height="42" VerticalAlignment="Bottom">
                <Rectangle Tag = "Background" Fill="#FFFDE886"  StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="0,0,-1,0" RadiusX="20" RadiusY="20"/>
                <TextBlock Tag="Text" TextWrapping="Wrap" Language="ru-ru" FontSize="16" FontFamily="Comic Sans MS" TextAlignment="Center" Margin="10,8,10,8"><Run Text="Зарег"/><Run Language="ru-ru" Text="и"/><Run Text="стрироваться"/></TextBlock>
            </Grid>

            <CheckBox Name="Remember_Me_Sign" Cursor="Hand" Content="Запомнить" HorizontalAlignment="Left" Margin="81,0,0,148" VerticalAlignment="Bottom" Width="114" FontSize="17" Height="25" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Name="Server_Info_Panel" Margin="0,422,0,0" HorizontalAlignment="Center" Width="388" Height="128" VerticalAlignment="Top" Visibility="Visible">

            <Rectangle Fill="#FFFFBC4E" Opacity="0.955" StrokeThickness="1.5" Stroke="#FF5D5D5D" RadiusX="20" RadiusY="20" RenderTransformOrigin="0.5,0.5"/>

            <Grid Margin="38,10,64,0" Height="48" VerticalAlignment="Top">
                <Rectangle Fill="White" StrokeThickness="1.5" Stroke="#FF5D5D5D" RadiusX="20" RadiusY="20"/>
                <TextBlock TextWrapping="Wrap" Language="ru-ru" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Center" Margin="0,7,0,7" Text="IP Адрес и Порт Сервера" Foreground="Black" />
            </Grid>

            <Grid Cursor="Hand" Name="Server_Info" Height="16" Width="27" Margin="342,25,18,0" VerticalAlignment="Top">
                <Grid.RenderTransform>
                    <RotateTransform CenterX="13.5" CenterY="8"/>
                </Grid.RenderTransform>
                <Rectangle Fill="Transparent"/>
                <Line X1="1" Y1="2" X2="14" Y2="14" Stroke="#FF9A0F0F" StrokeThickness="3"/>
                <Line X1="12" Y1="14" X2="25" Y2="2"  Stroke="#FF9A0F0F" StrokeThickness="3"/>
            </Grid>

            <Grid Name="Server_IP_Text" HorizontalAlignment="Left" Width="183" Margin="38,0,0,12" Height="48" VerticalAlignment="Bottom">
                <Rectangle Fill="#FFFFFAE0" StrokeThickness="1.5" Stroke="#FF5D5D5D" Margin="0,0,-1,0" RadiusX="20" RadiusY="20"/>
                <TextBox Name="TextBox_IP_Hint" TextWrapping="Wrap" Language="ru-ru" Background="Transparent" FontSize="19" FontFamily="Comic Sans MS" TextAlignment="Center" Text="95.154.89.8" Margin="10,10,10,10" BorderThickness="0" IsEnabled="False"/>
                <TextBox Cursor="IBeam" TextChanged="ChangedText_Page" Name="TextBox_IP" Text="" TextWrapping="NoWrap" Language="ru-ru" Background="Transparent" FontSize="19" FontFamily="Comic Sans MS" TextAlignment="Center" Margin="10,10,10,10" BorderThickness="0" MaxLength="15"/>
            </Grid>

            <Grid Name="Ping_Button" Height="48" VerticalAlignment="Bottom" Margin="226,0,102,12" ToolTip="Пока что в разработке" Cursor="Hand">
                <Rectangle Fill="#FFFFE667" StrokeThickness="1.5" Stroke="#FF5D5D5D" RadiusX="20" RadiusY="20"/>
                <TextBlock Foreground="#FF252525" Background="Transparent" FontSize="20" FontFamily="Comic Sans MS" TextAlignment="Center" Text="Ping" Margin="10,8,10,12" IsEnabled="False"/>
            </Grid>

            <Grid Name="Reload_Connection_Button" Height="40" Width="40" Cursor="Hand" Margin="291,72,57,16">

                <Rectangle Tag="Background" Fill="#FFFFFAE0" Opacity="0.7" RadiusX="50" RadiusY="50" Stroke="Gray" StrokeThickness="1.5"/>

                <Ellipse Stroke="#FF9A0F0F" StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Width="26" Height="26">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="-1"/>
                            <SkewTransform/>
                            <RotateTransform Angle="271.727"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                    <Ellipse.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.5" Color="#FF9A0F0F"/>
                            <GradientStop Offset="0.5" Color="Transparent"/>
                            <GradientStop Offset="1" Color="Transparent"/>
                        </LinearGradientBrush>
                    </Ellipse.OpacityMask>
                </Ellipse>
                <Ellipse Stroke="#FF9A0F0F" StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Width="26" Height="26">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="-1"/>
                            <SkewTransform/>
                            <RotateTransform Angle="180"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                    <Ellipse.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.5" Color="#FF9A0F0F"/>
                            <GradientStop Offset="0.5" Color="Transparent"/>
                            <GradientStop Offset="1" Color="Transparent"/>
                        </LinearGradientBrush>
                    </Ellipse.OpacityMask>
                </Ellipse>

                <Path Fill="#FF9A0F0F" StrokeThickness="0.5" Margin="28,20,4,13" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="-180"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="50,10">
                                <LineSegment Point="10,90"/>
                                <LineSegment Point="90,90"/>
                                <LineSegment Point="50,10"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Grid>
        </Grid>
    </Grid>
</Page>
